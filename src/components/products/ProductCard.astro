---
import { formatPrice } from "../../lib/format";
import { createWhatsAppLink } from "../../lib/whatsapp";

const { product } = Astro.props;

const {
  title,
  image,
  price,
  oldPrice,
  stock,
} = product.data;

// Calculamos si tiene descuento para mostrar una etiqueta pequeña
const discount = oldPrice ? Math.round(((oldPrice - price) / oldPrice) * 100) : 0;
---

<div class="group relative bg-zinc-900 border border-zinc-800/80 rounded-xl md:rounded-2xl overflow-hidden flex flex-col h-full transition-all duration-200 hover:border-zinc-700/50 hover:shadow-lg hover:shadow-black/20">
  
  {/* IMAGEN DEL PRODUCTO (Estilo App limpia) */}
  <a href={`/producto/${product.id}`} class="relative block aspect-square w-full bg-zinc-950 p-2 overflow-hidden border-b border-zinc-800/40">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
    />
    
    {/* Etiquetas flotantes sobre la imagen para ahorrar espacio vertical */}
    <div class="absolute top-2 left-2 flex flex-col gap-1.5 pointer-events-none">
      {stock <= 3 && stock > 0 && (
        <span class="text-[10px] md:text-xs font-bold bg-amber-500/10 border border-amber-500/20 text-amber-400 px-2 py-0.5 rounded-md backdrop-blur-sm">
          Pocas unidades
        </span>
      )}
      {stock === 0 && (
        <span class="text-[10px] md:text-xs font-bold bg-red-500/10 border border-red-500/20 text-red-400 px-2 py-0.5 rounded-md backdrop-blur-sm">
          Agotado
        </span>
      )}
    </div>
  </a>

  {/* INFORMACIÓN Y DETALLES */}
  <div class="p-3 md:p-4 flex flex-col grow justify-between gap-3">
    
    <div>
      {/* TÍTULO: Controlado a un tamaño amigable y máximo 2 líneas para que no desajuste el grid */}
      <a href={`/producto/${product.id}`} class="block group-hover:text-green-400 transition-colors">
        <h3 class="font-medium text-sm md:text-base text-zinc-200 line-clamp-2 min-h-10 md:min-h-12 leading-snug">
          {title}
        </h3>
      </a>

      {/* PRECIO (Formato App vertical/compacto) */}
      <div class="flex flex-col md:flex-row md:items-baseline gap-0.5 md:gap-2 mt-2">
        <span class="text-lg md:text-xl font-bold text-white tracking-tight">
          {formatPrice(price)}
        </span>
        
        {oldPrice && (
          <div class="flex items-center gap-1.5">
            <span class="text-zinc-500 line-through text-xs font-normal">
              {formatPrice(oldPrice)}
            </span>
            {discount > 0 && (
              <span class="text-green-400 text-[10px] md:text-xs font-bold">
                {discount}% OFF
              </span>
            )}
          </div>
        )}
      </div>
    </div>

    {/* BOTÓN ÚNICO DE COMPRA RÁPIDA: Quitamos el botón doble */}
    <div class="mt-auto">
      <a
        href={createWhatsAppLink(title)}
        target="_blank"
        class="w-full h-9 md:h-11 rounded-lg bg-[#25D366] text-white flex items-center justify-center font-bold text-xs md:text-sm gap-1.5 shadow-sm shadow-[#25D366]/10 hover:bg-[#1EBE5D] active:scale-[0.97] transition-all duration-150"
      >
        {/* Icono de carrito minimalista */}
        <svg class="w-3.5 h-3.5 md:w-4 md:h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
        Comprar
      </a>
    </div>

  </div>

</div>