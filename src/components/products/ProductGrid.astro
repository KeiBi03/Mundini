---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content"; 
import ProductCard from "./ProductCard.astro";

const products = await getCollection("products");

const featuredProducts: CollectionEntry<"products">[] = products.filter(
  (product: CollectionEntry<"products">) => product.data.featured
);
---

<section class="py-12 md:py-16">
  <div class="container-custom">

    <div class="mb-8 md:mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold text-zinc-400 uppercase tracking-widest">
          Productos destacados
        </p>
        <h2 class="text-2xl md:text-3xl font-bold mt-2 text-white">
          Catálogo
        </h2>
      </div>
      
      <a href="/productos" class="text-sm text-green-400 hover:text-green-300 font-medium transition-colors">
        Ver todo &rarr;
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2 md:gap-4">
      {
        featuredProducts.map((product) => (
          <ProductCard product={product} />
        ))
      }
    </div>

  </div>
</section>