---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import RelatedProducts from "../../components/products/RelatedProducts.astro";
import MainLayout from "../../layout/MainLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import ProductGallery from "../../components/products/ProductGallery.astro";

import { formatPrice } from "../../lib/format";
import { createWhatsAppLink } from "../../lib/whatsapp";

export async function getStaticPaths() {
  const products = await getCollection("products");

  return products.map((product) => ({
    params: {
      slug: product.id,
    },
    props: {
      product,
    },
  }));
}

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props as Props;

const {
  title,
  description,
  image,
  gallery,
  price,
  oldPrice,
  stock,
} = product.data;

const images = gallery?.length ? gallery : [image];

// Calculamos el porcentaje de descuento si existe un precio antiguo
const discountPercentage = oldPrice 
  ? Math.round(((oldPrice - price) / oldPrice) * 100) 
  : 0;
---

<MainLayout
  title={`${title} | Mundial Store`}
  description={description}
>
  <Navbar />

  <main class="py-10 md:py-16">
    <div class="container-custom">
      
      {/* Grid modificado: 5 columnas para galería, 7 para contenido para que la imagen no sea gigante */}
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        
        {/* GALERÍA */}
        <div class="lg:col-span-5 w-full max-w-md mx-auto lg:max-w-none">
          <ProductGallery
            images={images}
            title={title}
          />
        </div>

        {/* INFORMACIÓN DEL PRODUCTO */}
        <div class="lg:col-span-7 sticky top-24">
          
          <span class="text-xs md:text-sm font-semibold text-zinc-400 uppercase tracking-widest">
            Producto original sellado
          </span>

          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mt-3 leading-tight text-white">
            {title}
          </h1>

          <div class="flex items-end gap-4 mt-6">
            <span class="text-4xl md:text-5xl font-black text-white">
              {formatPrice(price)}
            </span>
            
            {oldPrice && (
              <div class="flex flex-col pb-1">
                <span class="text-zinc-500 line-through text-lg md:text-xl font-medium">
                  {formatPrice(oldPrice)}
                </span>
                {discountPercentage > 0 && (
                  <span class="text-green-400 text-sm font-bold">
                    {discountPercentage}% OFF
                  </span>
                )}
              </div>
            )}
          </div>

          <div class="mt-6">
            {stock > 0 ? (
              <div class="inline-flex items-center gap-2 bg-green-500/10 border border-green-500/20 text-green-400 px-4 py-2 rounded-full text-sm font-medium">
                <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                Stock disponible: {stock}
              </div>
            ) : (
              <div class="inline-flex items-center gap-2 bg-red-500/10 border border-red-500/20 text-red-400 px-4 py-2 rounded-full text-sm font-medium">
                <span class="w-2 h-2 rounded-full bg-red-500"></span>
                Agotado temporalmente
              </div>
            )}
          </div>

          {/* BOTÓN DE COMPRA (Estilo App/WhatsApp) */}
          <a
            href={createWhatsAppLink(title)}
            target="_blank"
            class="mt-10 w-full h-14 rounded-xl bg-[#25D366] text-white flex items-center justify-center font-bold text-lg shadow-lg shadow-[#25D366]/20 hover:bg-[#1EBE5D] hover:scale-[1.02] transition-all duration-300"
          >
            {/* Opcional: Puedes meter un SVG del logo de WhatsApp aquí */}
            Comprar por WhatsApp
          </a>

          {/* DESCRIPCIÓN */}
          <div class="mt-12 border-t border-zinc-800 pt-8">
            <h2 class="text-xl font-semibold text-white mb-4">
              Acerca de este producto
            </h2>
            <div class="prose prose-invert prose-zinc max-w-none text-zinc-400 leading-relaxed">
              <p>{description}</p>
            </div>
          </div>

        </div>
      </div>

      {/* SECCIÓN PRODUCTOS RELACIONADOS (Dentro del contenedor principal para mantener alineación) */}
      <div class="mt-24 border-t border-zinc-800/50 pt-16 pb-8">
        <RelatedProducts
          category={product.data.category}
          currentId={product.id}
        />
      </div>

    </div>
  </main>

  <Footer />
</MainLayout>